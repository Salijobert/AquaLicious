{
  "name": "aqualicious-backend",
  "version": "2.0.0",
  "description": "AquaLicious Express/TypeScript Backend with Prisma and PostgreSQL",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:pm2": "pm2 start ../ecosystem.config.cjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.4.1",
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.3",
    "pm2": "^5.4.3",
    "sanitize-html": "^2.14.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/sanitize-html": "^2.13.0",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
