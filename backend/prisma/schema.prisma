generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum ProductType {
  REFILL
  CONTAINER_WITH_WATER
  EMPTY_CONTAINER
  ACCESSORY
}

enum OrderType {
  WALK_IN_POS
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  CASH
  E_WALLET
  GCASH_QR
  MAYA_QR
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  COMPLETED
  REJECTED
  REFUND_REQUIRED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
  VOIDED
}

enum MovementType {
  RESTOCK
  ADJUSTMENT
  SALE
  ORDER_RESERVATION
  ORDER_RELEASE
  VOID_RETURN
}

model User {
  id              Int              @id @default(autoincrement())
  firebaseUid     String           @unique
  name            String
  username        String           @unique
  email           String           @unique
  phone           String?
  address         String?
  role            Role             @default(CUSTOMER)
  emailVerified   Boolean          @default(false)
  verificationDeadline DateTime?   @map("verification_deadline")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  salesOrders     SalesOrder[]     @relation("OrderUser")
  verifiedOrders  SalesOrder[]     @relation("OrderVerifiedBy")
  stockMovements  StockMovement[]
  idempotencyLogs IdempotencyLog[]
  consents        UserConsent[]
  emailLogs       EmailLog[]

  @@map("users")
}

model UserConsent {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consent      Boolean  @default(true)
  termsVersion String
  acceptedAt   DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  @@map("user_consents")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id             Int             @id @default(autoincrement())
  sku            String          @unique
  name           String
  productType    ProductType     @default(REFILL)
  volumeLabel    String          @default("5-Gallon")
  imageUrl       String?
  categoryId     Int
  category       Category        @relation(fields: [categoryId], references: [id])
  sellingPrice   Decimal         @db.Decimal(10, 2)
  productionCost Decimal         @default(0) @db.Decimal(10, 2)
  stock          Int             @default(0)
  reorderPt      Int             @default(0)
  leadTimeDays   Int             @default(2)
  safetyStock    Int             @default(10)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  saleItems      SalesOrderItem[]
  stockMovements StockMovement[]

  @@map("products")
}

model SalesOrder {
  id               Int              @id @default(autoincrement())
  orderNumber      String           @unique
  userId           Int
  user             User             @relation("OrderUser", fields: [userId], references: [id])
  customerId       Int?
  customerName     String?          @map("customer_name")
  legacyPaymentMethod String?       @map("legacy_payment_method")
  orderType        OrderType        @default(WALK_IN_POS)
  deliveryAddress  String?
  subtotal         Decimal          @db.Decimal(10, 2)
  tax              Decimal          @default(0) @db.Decimal(10, 2)
  discount         Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal          @db.Decimal(10, 2)
  cashTendered     Decimal?         @db.Decimal(10, 2)
  changeDue        Decimal?         @db.Decimal(10, 2)
  paymentMethod    PaymentMethod    @default(CASH)
  paymentStatus    PaymentStatus    @default(PENDING)
  paymentReference String?
  proofBase64      String?          @db.Text
  verifiedById     Int?             @map("verified_by_id")
  verifiedBy       User?            @relation("OrderVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt       DateTime?        @map("verified_at")
  orderStatus      OrderStatus      @default(COMPLETED)
  requestKey       String?          @unique
  voidReason       String?
  voidedById       Int?
  voidedAt         DateTime?
  notes            String?
  createdAt        DateTime         @default(now())

  items            SalesOrderItem[]
  emailLogs        EmailLog[]

  @@map("sales_orders")
}

model SalesOrderItem {
  id               Int        @id @default(autoincrement())
  salesOrderId     Int
  salesOrder       SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product    @relation(fields: [productId], references: [id])
  quantity         Int
  unitPrice        Decimal    @db.Decimal(10, 2)
  unitCostSnapshot Decimal    @db.Decimal(10, 2)
  subtotal         Decimal    @db.Decimal(10, 2)

  @@map("sales_order_items")
}

model StockMovement {
  id              Int          @id @default(autoincrement())
  productId       Int
  product         Product      @relation(fields: [productId], references: [id])
  movementType    MovementType
  quantityChange  Int
  previousBalance Int
  newBalance      Int
  referenceId     Int?
  userId          Int
  user            User         @relation(fields: [userId], references: [id])
  notes           String?
  createdAt       DateTime     @default(now())

  @@map("stock_movements")
}

model IdempotencyLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  requestKey   String
  requestHash  String
  responseCode Int
  responseBody String   @db.Text
  createdAt    DateTime @default(now())

  @@unique([userId, requestKey])
  @@map("idempotency_logs")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  Int?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model EmailLog {
  id        Int         @id @default(autoincrement())
  type      String      // 'VERIFICATION' | 'PASSWORD_RESET' | 'ORDER_RECEIPT' | 'ORDER_STATUS' | 'ADMIN_ALERT'
  orderId   Int?
  userId    Int?
  toEmail        String
  status         String      // 'SENT' | 'FAILED'
  error          String?
  idempotencyKey String?
  sentAt         DateTime    @default(now())

  order     SalesOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId, type])
  @@index([toEmail, type])
  @@map("email_logs")
}
