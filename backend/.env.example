DATABASE_URL="postgresql://postgres@localhost:5432/aqualicious_pg?schema=public"
PORT=8088
FAILOVER_PORT=8089
NODE_ENV=development
ADMIN_FIREBASE_UIDS="" # Comma-separated Firebase UIDs authorized for Administrator accounts (mandatory in production)
ADMIN_FIREBASE_UID=""
CORS_ORIGINS="http://localhost:5173,http://localhost:8080,http://localhost:8090,https://localhost,capacitor://localhost"
FIREBASE_PROJECT_ID="aqualicious-pos"
GCASH_QR_URL=""
MAYA_QR_URL=""
TIMEZONE="Asia/Manila"
CLUSTER_ID="aqualicious-cluster-primary"

# Transactional Email (Gmail SMTP with Google App Password)
ADMIN_EMAIL="aqualiciousadmin@gmail.com"
MAIL_FROM_NAME="AquaLicious"
SMTP_USER="aqualiciousadmin@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
FRONTEND_URL="https://aqualicious.vercel.app"
AQ_MOCK_MAIL="false"
# 30-day unverified account cleanup (defaults to true if unset)
CLEANUP_DRY_RUN="true"
